{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLink",
  "version": "0.2.2",
  "identifier": "com.paperlink.localmcp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paper Link",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
